---
import Layout from '../layouts/Layout.astro';
import { m } from '../paraglide/messages.js';
---
<Layout title={m.site_title()} description={m.site_tagline()}>
  <main class="mx-auto max-w-2xl px-6 py-24">
    <p
      class="font-mono text-[10px] tracking-[0.14em] uppercase"
      style="color: var(--ink-faint);"
    >
      {m.scaffold_ok()}
    </p>

    <h1
      class="font-display mt-3 text-5xl leading-[1.1] tracking-[-0.02em]"
      style="color: var(--ink);"
    >
      {m.site_title()}
    </h1>

    <p
      class="mt-4 text-base leading-relaxed"
      style="color: var(--ink-soft);"
    >
      {m.site_tagline()}
    </p>

    <div class="mt-10 flex gap-2" aria-hidden="true">
      <span class="h-6 w-6 rounded" style="background: var(--band-a);"></span>
      <span class="h-6 w-6 rounded" style="background: var(--band-b);"></span>
      <span class="h-6 w-6 rounded" style="background: var(--band-c);"></span>
      <span class="h-6 w-6 rounded" style="background: var(--band-d);"></span>
      <span class="h-6 w-6 rounded" style="background: var(--band-e);"></span>
      <span class="h-6 w-6 rounded" style="background: var(--band-x);"></span>
    </div>
  </main>
</Layout>
